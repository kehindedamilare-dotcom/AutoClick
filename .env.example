# ---------------------------------------------------------------------------
# Copy to .env and fill in your key. Never commit .env.
# ---------------------------------------------------------------------------

# Provider: "openai" (default), "anthropic", or "google" (Gemini)
AGENT_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-gemini-key-here

# Model must support image input.
AGENT_MODEL=gpt-4o
# Optional OpenAI-compatible gateway
# AGENT_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# Ask y/n in the terminal before every action.
AGENT_HITL=false
# Global emergency stop (terminates the process).
AGENT_KILL_SWITCH_ENABLED=true
AGENT_KILL_SWITCH_HOTKEY=ctrl+alt+k
# PyAutoGUI fail-safe: slam the cursor into a screen corner to abort.
AGENT_FAILSAFE=true
AGENT_MAX_IDENTICAL_ACTIONS=3
AGENT_MAX_CONSECUTIVE_FAILURES=3

# ---------------------------------------------------------------------------
# Display / coordinates
# ---------------------------------------------------------------------------
# MSS index: 1 = primary display, 2 = secondary, ...
AGENT_MONITOR_INDEX=1
# Crop to a window, in PHYSICAL pixels of the MSS virtual desktop: left,top,width,height
# AGENT_ROI=100,100,1200,800
# Leave unset to auto-detect (1.5 for Windows 150%, 2.0 for macOS Retina).
# AGENT_DISPLAY_SCALE=1.5
AGENT_MAX_IMAGE_SIDE=1600
AGENT_BOUNDARY_BUFFER=5
AGENT_SAVE_SCREENSHOTS=true

# ---------------------------------------------------------------------------
# Humanized input timing (seconds)
# ---------------------------------------------------------------------------
AGENT_KEY_DELAY_RANGE=0.05,0.2
AGENT_MOVE_DURATION_RANGE=0.2,0.55
AGENT_MOVE_JITTER_PX=2
AGENT_PRE_CLICK_DELAY_RANGE=0.05,0.2
AGENT_SETTLE_RANGE=0.35,0.8
AGENT_WAIT_RANGE=1.0,2.0

# ---------------------------------------------------------------------------
# Loop budget + logging
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=25
AGENT_MAX_RUNTIME_SECONDS=900
AGENT_SCROLL_DEFAULT=4
AGENT_SCROLL_MAX=15
AGENT_LOG_LEVEL=INFO
AGENT_LOG_TO_FILE=true
# AGENT_LOG_FILE=./agent.log
